{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "alpainoo",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "alpainoo"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpainoo-db",
      "database_id": "225d3b73-040a-45fb-8f98-3df7528d8181"
    }
  ],
  // Uncomment after enabling R2 in the dashboard and creating `alpainoo-uploads`:
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "alpainoo-uploads" }],
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "AUTH_URL": "https://alpainoo.alpainoocompany.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://alpainoo.alpainoocompany.workers.dev"
  }
}
