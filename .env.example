# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="your-gmail@gmail.com"
# true = open /admin without Google (demo). Use false after Google OAuth works.
ADMIN_DEV_BYPASS="true"

# --- Database (PostgreSQL for Vercel / Neon) ---
# Create free DB at https://neon.tech → copy connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Local SQLite only if you switch prisma provider back to "sqlite":
# DATABASE_URL="file:./dev.db"

# --- Auth.js Google OAuth ---
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Local:
AUTH_URL="http://localhost:3000"
# On Vercel set to: https://YOUR-APP.vercel.app

# Razorpay (optional for demo — empty = demo payment)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Shiprocket (optional)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
