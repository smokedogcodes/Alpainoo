# =============================================================================
# Alpainoo environment variables
# NEVER commit real secrets. Client-safe vars MUST use NEXT_PUBLIC_ prefix only.
# =============================================================================

# --- Public (safe in browser) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public Razorpay key only (never put KEY_SECRET here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Server-only (do NOT prefix with NEXT_PUBLIC_) ---
ADMIN_EMAIL="your-gmail@gmail.com"
# Dev-only: open /admin without OAuth. Ignored when NODE_ENV=production.
ADMIN_DEV_BYPASS="false"

# Database — Cloudflare D1 locally uses SQLite file; Workers use the DB binding (no URL needed at runtime)
DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Razorpay (server)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shiprocket (server) — prefer API_* names; EMAIL/PASSWORD kept as fallbacks
SHIPROCKET_API_EMAIL=""
SHIPROCKET_API_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
# Optional legacy aliases:
# SHIPROCKET_EMAIL=""
# SHIPROCKET_PASSWORD=""
# SHIPROCKET_PICKUP_POSTCODE="110001"

# Transactional email — SMTP (Gmail) preferred; Resend / MailChannels as fallback
# Cloudflare Email Routing is receive-only; it cannot send order emails.
# On Workers, Gmail SMTP may fail (TCP); keep Resend/MailChannels as backup when EMAIL_PROVIDER=auto.
EMAIL_PROVIDER="auto"
EMAIL_FROM="Alpainoo <orders@yourdomain.com>"

# Gmail SMTP (App Password) — used for all transactional mail + phone OTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="app-password"
SMTP_FROM_NAME="Alpainoo"
SMTP_FROM_EMAIL="you@gmail.com"
SMTP_SECURE="false"

# Optional pepper for hashing phone OTPs (falls back to AUTH_SECRET)
OTP_PEPPER=""

# Resend — free ~100/day. Add domain in Resend, paste SPF/DKIM into Cloudflare DNS.
RESEND_API_KEY=""

# MailChannels — free 100/day. Sign up at mailchannels.com, add domain DNS on Cloudflare.
MAILCHANNELS_API_KEY=""

# ADMIN_EMAIL above is CC'd on every order email (plus store-owner addresses)

# Optional distributed rate limiting (Upstash Redis)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Gemini (support chatbot) — server only, from Google AI Studio / Cloud Console
GEMINI_API_KEY=""
# Optional model override (defaults try Gemini 3.x flash models, then auto-discover)
# GEMINI_MODEL="gemini-3.6-flash"
