# =============================================================================
# Elorakart environment variables
# NEVER commit real secrets. Client-safe vars MUST use NEXT_PUBLIC_ prefix only.
# =============================================================================

# --- Public (safe in browser) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public Razorpay key only (never put KEY_SECRET here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Server-only (do NOT prefix with NEXT_PUBLIC_) ---
ADMIN_EMAIL="your-gmail@gmail.com"
# Dev-only: open /admin without OAuth. Ignored when NODE_ENV=production.
ADMIN_DEV_BYPASS="false"

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Razorpay (server)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shiprocket (server)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Optional distributed rate limiting (Upstash Redis)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
