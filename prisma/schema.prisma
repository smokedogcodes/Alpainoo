generator client {
  provider = "prisma-client-js"
}

// Vercel demo: provider = "postgresql" + Neon/Vercel Postgres DATABASE_URL (current)
// Local SQLite:  provider = "sqlite"      + DATABASE_URL="file:./dev.db"
// Hostinger:     provider = "mysql"       + DATABASE_URL="mysql://USER:PASS@HOST:3306/DB"
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          String          @default("CUSTOMER")
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  chatSessions  ChatSession[]
  tickets       SupportTicket[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String
  brand        String
  volume       String?
  mrp          Float
  sellingPrice Float
  discount     Float       @default(0)
  sku          String      @unique
  stock        Int         @default(0)
  category     String
  benefits     String      @default("[]")
  ingredients  String?
  usage        String?
  images       String      @default("[]")
  rating       Float       @default(4.5)
  reviewCount  Int         @default(0)
  isHidden     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  stockLogs    StockLog[]
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  change    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  userId               String?
  user                 User?       @relation(fields: [userId], references: [id])
  email                String
  totalAmount          Float
  paymentStatus        String      @default("PENDING")
  orderStatus          String      @default("PENDING")
  razorpayOrderId      String?
  razorpayPaymentId    String?
  shippingAddress      String
  cancelRequestedAt    DateTime?
  cancelReason         String?
  previousOrderStatus  String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  items                OrderItem[]
  shipment             Shipment?

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@index([orderId])
  @@index([productId])
}

model Shipment {
  id                String  @id @default(cuid())
  orderId           String  @unique
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shiprocketOrderId String?
  shipmentId        String?
  awbCode           String?
  courierName       String?
  trackingStatus    String?
  trackingUrl       String?
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String
  content    String
  coverImage String?
  tags       String   @default("[]")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChatSession {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  ChatMessage[]
  tickets   SupportTicket[]

  @@index([userId])
  @@index([guestKey])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  intent    String?
  source    String?
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  question  String
  answer    String
  keywords  String   @default("[]")
  category  String   @default("GENERAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([category])
}

/// Cached Q&A pairs so similar support questions can skip Gemini.
model ChatAnswerCache {
  id                 String    @id @default(cuid())
  questionText       String
  questionNormalized String
  answer             String
  source             String    @default("gemini")
  intent             String?
  keywords           String    @default("[]")
  hitCount           Int       @default(0)
  lastHitAt          DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([questionNormalized])
  @@index([active])
  @@index([hitCount])
}

model SupportTicket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  name         String?
  subject      String
  description  String
  status       String       @default("OPEN")
  category     String       @default("GENERAL")
  tatHours     Int          @default(24)
  dueAt        DateTime
  sessionId    String?
  session      ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  adminReply   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([userId])
  @@index([sessionId])
  @@index([dueAt])
}

model SystemLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  level       String
  category    String
  action      String
  message     String
  entityType  String?
  entityId    String?
  actorUserId String?
  actorEmail  String?
  path        String?
  method      String?
  meta        String   @default("{}")

  @@index([level, createdAt])
  @@index([category, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model DbAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  tableName  String
  operation  String
  rowId      String?
  oldData    String?
  newData    String?

  @@index([tableName, createdAt])
  @@index([createdAt])
}

// Per-table transaction audit logs (populated by PostgreSQL triggers)
model OrderAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  operation String
  orderId   String?
  oldData   String?
  newData   String?

  @@index([orderId, createdAt])
  @@index([createdAt])
}

model OrderItemAudit {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  operation   String
  orderItemId String?
  orderId     String?
  oldData     String?
  newData     String?

  @@index([orderId, createdAt])
  @@index([createdAt])
}

model ShipmentAudit {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  operation  String
  shipmentId String?
  orderId    String?
  oldData    String?
  newData    String?

  @@index([orderId, createdAt])
  @@index([createdAt])
}

model ProductAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  operation String
  productId String?
  oldData   String?
  newData   String?

  @@index([productId, createdAt])
  @@index([createdAt])
}

model UserAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  operation String
  userId    String?
  oldData   String?
  newData   String?

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SupportTicketAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  operation String
  ticketId  String?
  oldData   String?
  newData   String?

  @@index([ticketId, createdAt])
  @@index([createdAt])
}
