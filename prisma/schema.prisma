generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Cloudflare D1 (SQLite). Local: DATABASE_URL="file:./dev.db"
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          String          @default("CUSTOMER")
  /// ADMIN | STAFF | TEMP | CUSTOMER — STAFF/TEMP use permissions JSON override (or role templates)
  permissions   String          @default("[]")
  /// When role is TEMP, access ends at this time (UTC).
  roleExpiresAt DateTime?
  avatarUrl     String?
  phone         String?
  /// Set when the profile phone passes email OTP verification.
  phoneVerifiedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  chatSessions  ChatSession[]
  tickets       SupportTicket[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  returnRequests ReturnRequest[]
  savedAddresses SavedAddress[]
  phoneOtps      PhoneOtp[]
  emailOtps      EmailOtp[]
}

model PhoneOtp {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime
  createdAt  DateTime @default(now())

  @@unique([userId])
  @@index([phone])
}

/// Pre-auth email OTP (guest checkout identity). Unique per email.
model EmailOtp {
  id         String   @id @default(cuid())
  email      String   @unique
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime
  createdAt  DateTime @default(now())
}

model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  name      String
  phone     String
  address   String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id                 String           @id @default(cuid())
  title              String
  slug               String           @unique
  description        String
  brand              String
  volume             String?
  mrp                Float
  sellingPrice       Float
  discount           Float            @default(0)
  sku                String           @unique
  stock              Int              @default(0)
  category           String
  benefits           String           @default("[]")
  ingredients        String?
  usage              String?
  images             String           @default("[]")
  rating             Float            @default(4.5)
  reviewCount        Int              @default(0)
  isHidden           Boolean          @default(false)
  metaTitle          String?
  metaDescription    String?
  lowStockThreshold  Int              @default(5)
  categoryId         String?
  categoryRef        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  orderItems         OrderItem[]
  stockLogs          StockLog[]
  variants           ProductVariant[]
  reviews            Review[]
  wishlistItems      WishlistItem[]
  collections        CollectionProduct[]
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  change    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  userId               String?
  user                 User?       @relation(fields: [userId], references: [id])
  email                String
  totalAmount          Float
  subtotalAmount       Float?
  discountAmount       Float       @default(0)
  shippingAmount       Float       @default(0)
  couponCode           String?
  paymentStatus        String      @default("PENDING")
  orderStatus          String      @default("PENDING")
  razorpayOrderId      String?
  razorpayPaymentId    String?
  shippingAddress      String
  cancelRequestedAt    DateTime?
  cancelReason         String?
  previousOrderStatus  String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  items                OrderItem[]
  shipment             Shipment?

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  quantity  Int
  price     Float

  @@index([orderId])
  @@index([productId])
}

model Shipment {
  id                String  @id @default(cuid())
  orderId           String  @unique
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingPartner   String?
  shiprocketOrderId String?
  shipmentId        String?
  awbCode           String?
  courierName       String?
  trackingStatus    String?
  trackingUrl       String?
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String
  coverImage      String?
  tags            String    @default("[]")
  published       Boolean   @default(false)
  scheduledAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ChatSession {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  ChatMessage[]
  tickets   SupportTicket[]

  @@index([userId])
  @@index([guestKey])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  intent    String?
  source    String?
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  question  String
  answer    String
  keywords  String   @default("[]")
  category  String   @default("GENERAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([category])
}

/// Cached Q&A pairs so similar support questions can skip Gemini.
model ChatAnswerCache {
  id                 String    @id @default(cuid())
  questionText       String
  questionNormalized String
  answer             String
  source             String    @default("gemini")
  intent             String?
  keywords           String    @default("[]")
  hitCount           Int       @default(0)
  lastHitAt          DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([questionNormalized])
  @@index([active])
  @@index([hitCount])
}

model SupportTicket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  name         String?
  subject      String
  description  String
  status       String       @default("OPEN")
  category     String       @default("GENERAL")
  tatHours     Int          @default(24)
  dueAt        DateTime
  sessionId    String?
  session      ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  adminReply   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([userId])
  @@index([sessionId])
  @@index([dueAt])
}

model SystemLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  level       String
  category    String
  action      String
  message     String
  entityType  String?
  entityId    String?
  actorUserId String?
  actorEmail  String?
  path        String?
  method      String?
  meta        String   @default("{}")

  @@index([level, createdAt])
  @@index([category, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model DbAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  tableName  String
  operation  String
  rowId      String?
  oldData    String?
  newData    String?

  @@index([tableName, createdAt])
  @@index([createdAt])
}

// Per-table transaction audit logs (populated by PostgreSQL triggers)
model OrderAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  operation String
  orderId   String?
  oldData   String?
  newData   String?

  @@index([orderId, createdAt])
  @@index([createdAt])
}

model OrderItemAudit {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  operation   String
  orderItemId String?
  orderId     String?
  oldData     String?
  newData     String?

  @@index([orderId, createdAt])
  @@index([createdAt])
}

model ShipmentAudit {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  operation  String
  shipmentId String?
  orderId    String?
  oldData    String?
  newData    String?

  @@index([orderId, createdAt])
  @@index([createdAt])
}

model ProductAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  operation String
  productId String?
  oldData   String?
  newData   String?

  @@index([productId, createdAt])
  @@index([createdAt])
}

model UserAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  operation String
  userId    String?
  oldData   String?
  newData   String?

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SupportTicketAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  operation String
  ticketId  String?
  oldData   String?
  newData   String?

  @@index([ticketId, createdAt])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  coverImage  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    CollectionProduct[]
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  productId    String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  sku          String  @unique
  scent        String?
  size         String?
  mrp          Float?
  sellingPrice Float?
  stock        Int     @default(0)

  @@index([productId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  // PERCENT | FIXED | PERCENT_CAPPED | FREE_SHIPPING
  kind          String?
  percentOff    Float?
  amountOff     Float?
  minOrder      Float     @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  active        Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  rating    Int
  title     String?
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, approved])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ReturnRequest {
  id          String   @id @default(cuid())
  orderId     String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason      String
  status      String   @default("REQUESTED")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model EmailCampaign {
  id        String   @id @default(cuid())
  subject   String
  bodyHtml  String
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                 String  @id @default("default")
  gstin              String?
  businessName       String?
  businessAddress    String?
  invoicePrefix      String  @default("ALP")
  lowStockDefault    Int     @default(5)
  metaPixelId        String?
  gaMeasurementId    String?
  /// JSON: { STAFF: PermissionMatrix, TEMP: PermissionMatrix }
  adminRoleTemplates String?
}

model AbandonedCart {
  id         String    @id @default(cuid())
  email      String
  payload    String
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
}

/// Admin-uploaded product images stored as binary in D1 (or local Prisma) when R2 is unavailable.
/// Keep each row well under D1's 2 MB row limit (target ≤500 KB after client compress).
model StoredImage {
  id        String   @id @default(cuid())
  mimeType  String
  bytes     Bytes
  byteSize  Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
